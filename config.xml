<?xml version='1.0' encoding='utf-8'?>
<widget id="com.salescode.organizagrana" version="1.0.0"
  xmlns="http://www.w3.org/ns/widgets"
  xmlns:cdv="http://cordova.apache.org/ns/1.0">

  <name>OrganizaGrana</name>
  <description>Gestao Financeira Pessoal</description>
  <author email="suporte@salescode.dev" href="https://www.salescode.dev">Sales. Dev</author>

  <content src="index.html" />

  <!-- Ícone do Aplicativo (Global) -->
  <icon src="public/img/logo.png" />

  <!-- Permite navegacao local -->
  <allow-navigation href="about:*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="mailto:*" />

  <!-- Preferencias Android -->
  <preference name="android-minSdkVersion" value="24" />
  <preference name="android-targetSdkVersion" value="36" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="false" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="KeyboardDisplayRequiresUserAction" value="false" />

  <!-- Preferências de Tela de Carregamento Nativa (Android 12+ Modern API) -->
  <preference name="SplashScreen" value="screen" />
  <preference name="SplashScreenDelay" value="2000" />
  <preference name="AutoHideSplashScreen" value="true" />
  <preference name="FadeSplashScreen" value="true" />
  <preference name="FadeSplashScreenDuration" value="300" />
  <preference name="ShowSplashScreenSpinner" value="false" />
  <preference name="AndroidWindowSplashScreenAnimatedIcon" value="public/img/logo.png" />
  <preference name="AndroidWindowSplashScreenBackground" value="#6C5CE7" />

  <!-- Plugins do Cordova -->
  <plugin name="cordova-sqlite-storage" spec="latest" />
  <plugin name="cordova-plugin-local-notification" spec="latest" />
  <plugin name="cordova-plugin-device" spec="latest" />
  <plugin name="cordova-plugin-file" spec="latest" />
  <plugin name="cordova-plugin-x-socialsharing" spec="latest" />

  <!-- Configurações para plataforma Android -->
  <platform name="android">
    <icon src="public/img/logo.png" density="ldpi" />
    <icon src="public/img/logo.png" density="mdpi" />
    <icon src="public/img/logo.png" density="hdpi" />
    <icon src="public/img/logo.png" density="xhdpi" />
    <icon src="public/img/logo.png" density="xxhdpi" />
    <icon src="public/img/logo.png" density="xxxhdpi" />
  </platform>

</widget>
