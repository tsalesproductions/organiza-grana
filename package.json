{
  "name": "com.salescode.organizagrana",
  "displayName": "OrganizaGrana",
  "version": "1.0.0",
  "description": "Gestao Financeira Pessoal - 100% offline",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build && node ./scripts/build-cordova.js && npx cordova build android",
    "build:android:release": "vite build && node ./scripts/build-cordova.js && npx cordova build android --release",
    "build-cordova": "cross-env TARGET=cordova NODE_ENV=production vite build && node ./scripts/build-cordova.js && npx cordova build android && npx cordova run android",
    "only-build-cordova": "cross-env TARGET=cordova NODE_ENV=production vite build && node ./scripts/build-cordova.js && npx cordova build android",
    "run-cordova": "npx cordova run android",
    "run-emulator": "npx cordova run android --emulator",
    "preview": "vite preview",
    "cordova": "npx cordova"
  },
  "keywords": [
    "ecosystem:cordova"
  ],
  "author": "Salescode",
  "license": "MIT",
  "dependencies": {
    "cordova-android": "^15.1.0",
    "framework7": "^8.3.3",
    "framework7-react": "^8.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "cordova": "^13.0.0",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^8.1.3",
    "cordova-plugin-local-notification": "^1.2.3",
    "cordova-plugin-x-socialsharing": "^6.0.4",
    "cordova-sqlite-storage": "^7.0.0",
    "cross-env": "^10.1.0",
    "es6-promise-plugin": "^4.2.2",
    "vite": "^5.4.0"
  },
  "cordova": {
    "plugins": {
      "cordova-sqlite-storage": {},
      "cordova-plugin-local-notification": {
        "ANDROIDX_CORE_VERSION": "1.12.0"
      },
      "cordova-plugin-device": {
        "ANDROIDX_CORE_VERSION": "1.12.0"
      },
      "cordova-plugin-camera": {
        "ANDROIDX_CORE_VERSION": "1.6.+"
      },
      "cordova-plugin-file": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      },
      "cordova-plugin-x-socialsharing": {
        "ANDROIDX_WEBKIT_VERSION": "1.4.0"
      }
    }
  }
}
